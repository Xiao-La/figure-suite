figure cols=3
panel (a) NFA for $(a|b)^*ab$
graph layout=line
  q_0 start
  q_1
  q_2 double
  q_0 -> q_1 a
  q_1 -> q_2 b
  q_0 -> q_0 "a,b" loop=above
panel (b) Turing machine in state $q_3$
array tape index=none
  \sqcup 1 0 1 1 \sqcup \sqcup
  shade: 4 lightblue
  ptr: q_3=4
panel (c) Hasse diagram of $2^{\{a,b,c\}}$
graph layout=layered dir=up shape=none spread=0.7
  e "\emptyset"
  a "\{a\}"
  b "\{b\}"
  c "\{c\}"
  ab "\{a,b\}"
  ac "\{a,c\}"
  bc "\{b,c\}"
  abc "\{a,b,c\}"
  e -- a
  e -- b
  e -- c
  a -- ab
  a -- ac
  b -- ab
  b -- bc
  c -- ac
  c -- bc
  ab -- abc
  ac -- abc
  bc -- abc
panel (d) parse tree of $a + b \times c$
tree shape=none
  E
    E
      T
        F
          a
    +
    T
      T
        F
          b
      \times
      F
        c
panel (e) Markov chain
graph layout=circle
  s "S"
  r "R"
  c "C"
  s -> r 0.3 bend=15
  r -> s 0.5 bend=15
  s -> s 0.7
  r -> c 0.5
  c -> s 1
panel (f) CYK table for $baaba$
table
  cols: b a a b a
  "\{B\}" "\{A,C\}" "\{A,C\}" "\{B\}" "\{A,C\}"
  "\{S,A\}" "\{B\}" "\{S,C\}" "\{S,A\}"
  \emptyset "\{B\}" "\{B\}"
  \emptyset "\{S,A,C\}"
  "\{S,A,C\}"
  shade: (5,1) lightblue
